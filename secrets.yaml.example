# Template for the shared etraffica-secrets Secret.
#
#   cp secrets.yaml.example secrets.yaml
#   # edit secrets.yaml, replacing every CHANGE_ME with a real value
#   kubectl apply -f secrets.yaml
#
# The real secrets.yaml is gitignored — never commit it.
apiVersion: v1
kind: Secret
metadata:
  name: etraffica-secrets
  namespace: etraffica
  labels:
    app: etraffica
type: Opaque
stringData:
  # --- Databases / cache / broker (required for split mode) --------------------
  DATABASE_URL: "CHANGE_ME"
  POSTGRES_URL: "CHANGE_ME"
  MONGODB_URL: "CHANGE_ME"
  REDIS_URL: "CHANGE_ME"
  REDIS_CACHE_URL: "CHANGE_ME"
  RABBITMQ_URL: "CHANGE_ME"
  BROKER_URL: "CHANGE_ME"

  # --- Auth --------------------------------------------------------------------
  JWT_SECRET: "CHANGE_ME"
  OIDC_ISSUER_URL: "CHANGE_ME"
  OIDC_CLIENT_SECRET: "CHANGE_ME"

  # --- Media (Cloudinary) ------------------------------------------------------
  CLOUDINARY_CLOUD_NAME: "CHANGE_ME"
  CLOUDINARY_API_KEY: "CHANGE_ME"
  CLOUDINARY_API_SECRET: "CHANGE_ME"

  # --- Payments ----------------------------------------------------------------
  PAYMENT_PROVIDER_SECRET: "CHANGE_ME"
  PROVIDER_CALLBACK_SECRET: "CHANGE_ME"
  PAYMENT_CALLBACK_SECRET_PAYSTACK: "CHANGE_ME"
  PAYMENT_CALLBACK_SECRET_FLUTTERWAVE: "CHANGE_ME"
  PAYMENT_SETTLEMENT_API_KEY: "CHANGE_ME"

  # --- Media processing provider ----------------------------------------------
  MEDIA_PROCESSING_API_KEY: "CHANGE_ME"
  MEDIA_CALLBACK_SECRET_CLOUDINARY: "CHANGE_ME"

  # --- Notification providers --------------------------------------------------
  NOTIFICATION_PROVIDER_API_KEY_EMAIL: "CHANGE_ME"
  NOTIFICATION_PROVIDER_API_KEY_SMS: "CHANGE_ME"
  NOTIFICATION_PROVIDER_API_KEY_PUSH: "CHANGE_ME"
  NOTIFICATION_PROVIDER_API_KEY_WEBHOOK: "CHANGE_ME"
  NOTIFICATION_CALLBACK_SECRET_SENDGRID: "CHANGE_ME"
  NOTIFICATION_CALLBACK_SECRET_TWILIO: "CHANGE_ME"
